// AEGIS — Toutes les mesures, par page : 1 Cockpit · 2 Trajectoire · 3 Contributeurs · 4 Valideurs
// Modèle Risk-Flow Vue global
// Tables utilisées : CampagnesEnCours, SuiviValidationParagraphe, Utilisateurs, Dates, _Mesures
// Les mesures déjà présentes seront mises à jour, les autres créées
// À coller dans la vue Requête DAX, puis « Update model with changes »

DEFINE
    // ==================== 1 COCKPIT ====================
    // ---------- 1.1 Calendrier ----------
    MEASURE '_Mesures'[Date fermeture] =
        MAX ( CampagnesEnCours[DateFermeture] )

    MEASURE '_Mesures'[Date lancement] =
        MAX ( CampagnesEnCours[DateLancement] )

    MEASURE '_Mesures'[Jours avant fermeture] =
        DATEDIFF ( TODAY (), [Date fermeture], DAY )

    MEASURE '_Mesures'[Libellé compte à rebours] =
        VAR j = [Jours avant fermeture]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( j ), "—",
                j > 0, "J-" & j,
                j = 0, "Jour J",
                "J+" & ABS ( j )
            )

    MEASURE '_Mesures'[% temps écoulé] =
        VAR total = DATEDIFF ( [Date lancement], [Date fermeture], DAY )
        VAR ecoule = DATEDIFF ( [Date lancement], TODAY (), DAY )
        RETURN
            MIN ( 1, MAX ( 0, DIVIDE ( ecoule, total ) ) )

    MEASURE '_Mesures'[Jours ouvrés restants] =
        MAX ( 0, NETWORKDAYS ( TODAY (), [Date fermeture] ) )

    // ---------- 1.2 Volumes (unité = paragraphe) ----------
    MEASURE '_Mesures'[Nb paragraphes] =
        DISTINCTCOUNT ( SuiviValidationParagraphe[IDParagraphe] )

    // Soumis = toutes les lignes Contributeur du paragraphe sont « Terminée »
    MEASURE '_Mesures'[Nb soumis] =
        COALESCE (
            COUNTROWS (
                FILTER (
                    VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                    VAR nbC =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur"
                        )
                    VAR nbT =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur",
                            SuiviValidationParagraphe[Statut] = "Terminée"
                        )
                    RETURN
                        nbC > 0 && nbC = nbT
                )
            ),
            0
        )

    // Refusé = au moins une ligne Contributeur dont le statut contient « Refus »
    MEASURE '_Mesures'[Nb refusés à reprendre] =
        COALESCE (
            COUNTROWS (
                FILTER (
                    VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                    NOT ISBLANK (
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur",
                            FILTER (
                                VALUES ( SuiviValidationParagraphe[Statut] ),
                                CONTAINSSTRING ( SuiviValidationParagraphe[Statut], "Refus" )
                            )
                        )
                    )
                )
            ),
            0
        )

    // Validé = toutes les lignes Valideur du paragraphe sont « Validé »
    MEASURE '_Mesures'[Nb validés N1] =
        COALESCE (
            COUNTROWS (
                FILTER (
                    VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                    VAR nbV =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Valideur"
                        )
                    VAR nbOK =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Valideur",
                            SuiviValidationParagraphe[Statut] = "Validé"
                        )
                    RETURN
                        nbV > 0 && nbV = nbOK
                )
            ),
            0
        )

    MEASURE '_Mesures'[Nb à valider] =
        MAX ( 0, [Nb soumis] - [Nb validés N1] )

    MEASURE '_Mesures'[Nb non soumis] =
        MAX ( 0, [Nb paragraphes] - [Nb soumis] - [Nb refusés à reprendre] )

    // ---------- 1.3 KPI ----------
    MEASURE '_Mesures'[% Contribution] =
        DIVIDE ( [Nb soumis], [Nb paragraphes] )

    MEASURE '_Mesures'[% Validation N1] =
        DIVIDE ( [Nb validés N1], [Nb paragraphes] )

    // Sans journal d'événements : refus actuellement en cours / décisions visibles
    MEASURE '_Mesures'[Taux de refus] =
        DIVIDE ( [Nb refusés à reprendre], [Nb validés N1] + [Nb refusés à reprendre] )

    // Écart en jours entre la dernière action du valideur et celle du contributeur
    MEASURE '_Mesures'[Délai de décision (j)] =
        MEDIANX (
            VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
            VAR nbV =
                CALCULATE (
                    COUNTROWS ( SuiviValidationParagraphe ),
                    SuiviValidationParagraphe[Role] = "Valideur"
                )
            VAR nbOK =
                CALCULATE (
                    COUNTROWS ( SuiviValidationParagraphe ),
                    SuiviValidationParagraphe[Role] = "Valideur",
                    SuiviValidationParagraphe[Statut] = "Validé"
                )
            VAR dc =
                CALCULATE (
                    MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                    SuiviValidationParagraphe[Role] = "Contributeur"
                )
            VAR dv =
                CALCULATE (
                    MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                    SuiviValidationParagraphe[Role] = "Valideur"
                )
            RETURN
                IF (
                    nbV > 0 && nbV = nbOK && NOT ISBLANK ( dc ) && NOT ISBLANK ( dv ) && dv >= dc,
                    CONVERT ( dv - dc, DOUBLE )
                )
        )

    // ---------- 1.4 Atterrissage ----------
    // Paragraphes soumis au cours des 7 derniers jours (≈ 5 jours ouvrés), par jour ouvré
    MEASURE '_Mesures'[Rythme soumission] =
        VAR n =
            COUNTROWS (
                FILTER (
                    VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                    VAR nbC =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur"
                        )
                    VAR nbT =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur",
                            SuiviValidationParagraphe[Statut] = "Terminée"
                        )
                    VAR dc =
                        CALCULATE (
                            MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                            SuiviValidationParagraphe[Role] = "Contributeur"
                        )
                    RETURN
                        nbC > 0 && nbC = nbT && dc >= TODAY () - 7
                )
            )
        RETURN
            DIVIDE ( COALESCE ( n, 0 ), 5 )

    MEASURE '_Mesures'[Atterrissage prévu] =
        MIN (
            1,
            DIVIDE ( [Nb soumis] + [Rythme soumission] * [Jours ouvrés restants], [Nb paragraphes] )
        )

    MEASURE '_Mesures'[Libellé atterrissage] =
        "Atterrissage " & FORMAT ( [Atterrissage prévu], "0 %" )

    // ---------- 1.5 Par rapport / porte N2 ----------
    // Rôle N2 cherché dans Utilisateurs : contient « N2 » (à confirmer)
    MEASURE '_Mesures'[Nb valideurs N2] =
        VAR r = SELECTEDVALUE ( SuiviValidationParagraphe[IDRapport] )
        RETURN
            COALESCE (
                COUNTROWS (
                    FILTER (
                        ALL ( Utilisateurs ),
                        Utilisateurs[IDRapport] = r
                            && CONTAINSSTRING ( Utilisateurs[Role], "N2" )
                    )
                ),
                0
            )

    MEASURE '_Mesures'[Porte N2] =
        VAR v = [% Validation N1]
        RETURN
            IF (
                HASONEVALUE ( SuiviValidationParagraphe[IDRapport] ),
                SWITCH (
                    TRUE (),
                    [Nb valideurs N2] = 0, "N2 non renseigné",
                    v = 1, "Prêt pour N2",
                    v >= 0.8, "Ouverture proche",
                    "En attente N1"
                )
            )

    // ---------- 1.6 Alertes ----------
    MEASURE '_Mesures'[Nb rapports sans N2] =
        COALESCE (
            COUNTROWS (
                FILTER ( VALUES ( SuiviValidationParagraphe[IDRapport] ), [Nb valideurs N2] = 0 )
            ),
            0
        )

    MEASURE '_Mesures'[Nb chapitres partiellement soumis] =
        COALESCE (
            COUNTROWS (
                FILTER (
                    SUMMARIZE (
                        SuiviValidationParagraphe,
                        SuiviValidationParagraphe[IDRapport],
                        SuiviValidationParagraphe[Chapitre]
                    ),
                    VAR nbC =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur"
                        )
                    VAR nbT =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur",
                            SuiviValidationParagraphe[Statut] = "Terminée"
                        )
                    RETURN
                        nbT > 0 && nbT < nbC
                )
            ),
            0
        )

    MEASURE '_Mesures'[Libellé alerte N2] =
        VAR n = [Nb rapports sans N2]
        RETURN
            IF ( n > 0, n & " rapport(s) sans valideur N2" )

    MEASURE '_Mesures'[Libellé alerte chapitres] =
        VAR n = [Nb chapitres partiellement soumis]
        RETURN
            IF ( n > 0, n & " chapitre(s) partiellement soumis" )

    MEASURE '_Mesures'[Dernière action] =
        "Dernière action " & FORMAT ( MAX ( SuiviValidationParagraphe[DateContributionValidation] ), "dd/MM HH:mm" )

    // ---------- 1.7 Couleurs (mise en forme conditionnelle → Field value) ----------
    MEASURE '_Mesures'[Couleur taux de refus] =
        IF ( [Taux de refus] >= 0.15, "#C2410C", "#0E1B2C" )

    MEASURE '_Mesures'[Couleur atterrissage] =
        SWITCH (
            TRUE (),
            [Atterrissage prévu] >= 0.95, "#16357A",
            [Atterrissage prévu] >= 0.8, "#0E1B2C",
            "#C2410C"
        )

    MEASURE '_Mesures'[Couleur compte à rebours] =
        IF ( [Jours avant fermeture] <= 3, "#C2410C", "#7FA6EC" )

    MEASURE '_Mesures'[Couleur Porte N2] =
        SWITCH (
            [Porte N2],
            "N2 non renseigné", "#C2410C",
            "Ouverture proche", "#1F5FD1",
            "Prêt pour N2", "#16357A",
            "#4A5568"
        )

    MEASURE '_Mesures'[Couleur barre contribution] =
        IF ( [% Contribution] < [% temps écoulé] - 0.15, "#C2410C", "#1F5FD1" )

    // ==================== 2 TRAJECTOIRE ====================
    // (axe X = Dates[Date], table sans relation)
    MEASURE '_Mesures'[Aujourd'hui] =
        TODAY ()

    MEASURE '_Mesures'[% Contribution cumulée] =
        VAR d = MAX ( Dates[Date] )
        VAR n =
            COUNTROWS (
                FILTER (
                    VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                    VAR nbC =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur"
                        )
                    VAR nbT =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Contributeur",
                            SuiviValidationParagraphe[Statut] = "Terminée"
                        )
                    VAR dc =
                        CALCULATE (
                            MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                            SuiviValidationParagraphe[Role] = "Contributeur"
                        )
                    RETURN
                        nbC > 0 && nbC = nbT && dc < d + 1
                )
            )
        RETURN
            IF ( d <= TODAY (), DIVIDE ( COALESCE ( n, 0 ), [Nb paragraphes] ) )

    MEASURE '_Mesures'[% Validation cumulée] =
        VAR d = MAX ( Dates[Date] )
        VAR n =
            COUNTROWS (
                FILTER (
                    VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                    VAR nbV =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Valideur"
                        )
                    VAR nbOK =
                        CALCULATE (
                            COUNTROWS ( SuiviValidationParagraphe ),
                            SuiviValidationParagraphe[Role] = "Valideur",
                            SuiviValidationParagraphe[Statut] = "Validé"
                        )
                    VAR dv =
                        CALCULATE (
                            MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                            SuiviValidationParagraphe[Role] = "Valideur"
                        )
                    RETURN
                        nbV > 0 && nbV = nbOK && dv < d + 1
                )
            )
        RETURN
            IF ( d <= TODAY (), DIVIDE ( COALESCE ( n, 0 ), [Nb paragraphes] ) )

    MEASURE '_Mesures'[Rythme idéal] =
        VAR d = MAX ( Dates[Date] )
        RETURN
            DIVIDE (
                DATEDIFF ( [Date lancement], d, DAY ),
                DATEDIFF ( [Date lancement], [Date fermeture], DAY )
            )

    MEASURE '_Mesures'[Projection contribution] =
        VAR d = MAX ( Dates[Date] )
        RETURN
            IF (
                d >= TODAY (),
                MIN (
                    1,
                    DIVIDE (
                        [Nb soumis] + [Rythme soumission] * NETWORKDAYS ( TODAY (), d ),
                        [Nb paragraphes]
                    )
                )
            )

    MEASURE '_Mesures'[Point atterrissage] =
        IF ( MAX ( Dates[Date] ) = [Date fermeture], [Atterrissage prévu] )

    // ==================== 3 CONTRIBUTEURS ====================
    // ---------- 3.1 Charge × avancement (nuage) ----------
    MEASURE '_Mesures'[Nb assignés] =
        CALCULATE (
            COUNTROWS ( SuiviValidationParagraphe ),
            SuiviValidationParagraphe[Role] = "Contributeur"
        )

    MEASURE '_Mesures'[% soumis contributeur] =
        IF (
            NOT ISBLANK ( [Nb assignés] ),
            DIVIDE (
                CALCULATE (
                    COUNTROWS ( SuiviValidationParagraphe ),
                    SuiviValidationParagraphe[Role] = "Contributeur",
                    SuiviValidationParagraphe[Statut] = "Terminée"
                ),
                [Nb assignés]
            ) + 0
        )

    MEASURE '_Mesures'[Nb refus contributeur] =
        IF (
            NOT ISBLANK ( [Nb assignés] ),
            COALESCE (
                CALCULATE (
                    COUNTROWS ( SuiviValidationParagraphe ),
                    SuiviValidationParagraphe[Role] = "Contributeur",
                    FILTER (
                        VALUES ( SuiviValidationParagraphe[Statut] ),
                        CONTAINSSTRING ( SuiviValidationParagraphe[Statut], "Refus" )
                    )
                ),
                0
            )
        )

    MEASURE '_Mesures'[Taille bulle] =
        IF ( NOT ISBLANK ( [Nb assignés] ), [Nb refus contributeur] + 1 )

    MEASURE '_Mesures'[Couleur point] =
        IF ( [% soumis contributeur] < 0.5, "#C2410C", "#1F5FD1" )

    // ---------- 3.2 Carte des chapitres (matrice) ----------
    MEASURE '_Mesures'[Cellule chapitre] =
        IF (
            NOT ISBLANK ( [Nb assignés] ),
            IF (
                ISINSCOPE ( SuiviValidationParagraphe[Chapitre] ),
                " ",
                FORMAT ( [% soumis contributeur], "0 %" )
            )
        )

    MEASURE '_Mesures'[Couleur cellule chapitre] =
        VAR nbC = [Nb assignés]
        VAR nbRefus = [Nb refus contributeur]
        VAR nbT =
            CALCULATE (
                COUNTROWS ( SuiviValidationParagraphe ),
                SuiviValidationParagraphe[Role] = "Contributeur",
                SuiviValidationParagraphe[Statut] = "Terminée"
            )
        VAR paras =
            CALCULATETABLE (
                VALUES ( SuiviValidationParagraphe[IDParagraphe] ),
                SuiviValidationParagraphe[Role] = "Contributeur"
            )
        VAR nbV =
            CALCULATE (
                COUNTROWS ( SuiviValidationParagraphe ),
                REMOVEFILTERS ( SuiviValidationParagraphe ),
                SuiviValidationParagraphe[Role] = "Valideur",
                SuiviValidationParagraphe[IDParagraphe] IN paras
            )
        VAR nbOK =
            CALCULATE (
                COUNTROWS ( SuiviValidationParagraphe ),
                REMOVEFILTERS ( SuiviValidationParagraphe ),
                SuiviValidationParagraphe[Role] = "Valideur",
                SuiviValidationParagraphe[Statut] = "Validé",
                SuiviValidationParagraphe[IDParagraphe] IN paras
            )
        RETURN
            SWITCH (
                TRUE (),
                NOT ISINSCOPE ( SuiviValidationParagraphe[Chapitre] ) || ISBLANK ( nbC ), "#FFFFFF",
                nbRefus > 0, "#C2410C",
                nbT < nbC, "#C9D3E0",
                nbV > 0 && nbV = nbOK, "#16357A",
                "#7FA6EC"
            )

    // ==================== 4 VALIDEURS ====================
    // ---------- 4.1 File d'attente (contribution terminée, décision non prise) ----------
    MEASURE '_Mesures'[Nb en attente valideur] =
        COUNTROWS (
            FILTER (
                CALCULATETABLE (
                    SuiviValidationParagraphe,
                    SuiviValidationParagraphe[Role] = "Valideur"
                ),
                VAR p = SuiviValidationParagraphe[IDParagraphe]
                VAR s = SuiviValidationParagraphe[Statut]
                VAR nbC =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR nbT =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur",
                        SuiviValidationParagraphe[Statut] = "Terminée"
                    )
                VAR dc =
                    CALCULATE (
                        MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR age = INT ( TODAY () - dc )
                RETURN
                    nbC > 0 && nbC = nbT
                        && s <> "Validé"
                        && NOT CONTAINSSTRING ( s, "Refus" )
            )
        )

    MEASURE '_Mesures'[Nb attente 0-2 j] =
        COUNTROWS (
            FILTER (
                CALCULATETABLE (
                    SuiviValidationParagraphe,
                    SuiviValidationParagraphe[Role] = "Valideur"
                ),
                VAR p = SuiviValidationParagraphe[IDParagraphe]
                VAR s = SuiviValidationParagraphe[Statut]
                VAR nbC =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR nbT =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur",
                        SuiviValidationParagraphe[Statut] = "Terminée"
                    )
                VAR dc =
                    CALCULATE (
                        MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR age = INT ( TODAY () - dc )
                RETURN
                    nbC > 0 && nbC = nbT
                        && s <> "Validé"
                        && NOT CONTAINSSTRING ( s, "Refus" )
                        && age <= 2
            )
        )

    MEASURE '_Mesures'[Nb attente 3-5 j] =
        COUNTROWS (
            FILTER (
                CALCULATETABLE (
                    SuiviValidationParagraphe,
                    SuiviValidationParagraphe[Role] = "Valideur"
                ),
                VAR p = SuiviValidationParagraphe[IDParagraphe]
                VAR s = SuiviValidationParagraphe[Statut]
                VAR nbC =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR nbT =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur",
                        SuiviValidationParagraphe[Statut] = "Terminée"
                    )
                VAR dc =
                    CALCULATE (
                        MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR age = INT ( TODAY () - dc )
                RETURN
                    nbC > 0 && nbC = nbT
                        && s <> "Validé"
                        && NOT CONTAINSSTRING ( s, "Refus" )
                        && age >= 3 && age <= 5
            )
        )

    MEASURE '_Mesures'[Nb attente > 5 j] =
        COUNTROWS (
            FILTER (
                CALCULATETABLE (
                    SuiviValidationParagraphe,
                    SuiviValidationParagraphe[Role] = "Valideur"
                ),
                VAR p = SuiviValidationParagraphe[IDParagraphe]
                VAR s = SuiviValidationParagraphe[Statut]
                VAR nbC =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR nbT =
                    CALCULATE (
                        COUNTROWS ( SuiviValidationParagraphe ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur",
                        SuiviValidationParagraphe[Statut] = "Terminée"
                    )
                VAR dc =
                    CALCULATE (
                        MAX ( SuiviValidationParagraphe[DateContributionValidation] ),
                        REMOVEFILTERS ( SuiviValidationParagraphe ),
                        SuiviValidationParagraphe[IDParagraphe] = p,
                        SuiviValidationParagraphe[Role] = "Contributeur"
                    )
                VAR age = INT ( TODAY () - dc )
                RETURN
                    nbC > 0 && nbC = nbT
                        && s <> "Validé"
                        && NOT CONTAINSSTRING ( s, "Refus" )
                        && age > 5
            )
        )

    MEASURE '_Mesures'[% attente > 5 j] =
        DIVIDE ( [Nb attente > 5 j], [Nb en attente valideur] )

    // ---------- 4.2 Décisions ----------
    MEASURE '_Mesures'[Nb lignes valideur] =
        CALCULATE (
            COUNTROWS ( SuiviValidationParagraphe ),
            SuiviValidationParagraphe[Role] = "Valideur"
        )

    MEASURE '_Mesures'[Nb validations émises] =
        CALCULATE (
            COUNTROWS ( SuiviValidationParagraphe ),
            SuiviValidationParagraphe[Role] = "Valideur",
            SuiviValidationParagraphe[Statut] = "Validé"
        )

    MEASURE '_Mesures'[Nb refus émis] =
        CALCULATE (
            COUNTROWS ( SuiviValidationParagraphe ),
            SuiviValidationParagraphe[Role] = "Valideur",
            FILTER (
                VALUES ( SuiviValidationParagraphe[Statut] ),
                CONTAINSSTRING ( SuiviValidationParagraphe[Statut], "Refus" )
            )
        )

    MEASURE '_Mesures'[Nb décisions valideur] =
        COALESCE ( [Nb validations émises], 0 ) + COALESCE ( [Nb refus émis], 0 )

    MEASURE '_Mesures'[% décidé valideur] =
        DIVIDE ( [Nb décisions valideur], [Nb lignes valideur] )

    MEASURE '_Mesures'[Taux de refus valideur] =
        DIVIDE ( [Nb refus émis], [Nb décisions valideur] )

    // ---------- 4.3 Flux entrant vs capacité (axe X = Dates[Date]) ----------
    MEASURE '_Mesures'[Flux entrant (jour)] =
        VAR d = MAX ( Dates[Date] )
        RETURN
            COALESCE (
                CALCULATE (
                    COUNTROWS ( SuiviValidationParagraphe ),
                    SuiviValidationParagraphe[Role] = "Contributeur",
                    SuiviValidationParagraphe[Statut] = "Terminée",
                    SuiviValidationParagraphe[DateContributionValidation] >= d,
                    SuiviValidationParagraphe[DateContributionValidation] < d + 1
                ),
                0
            )

    MEASURE '_Mesures'[Décisions (jour)] =
        VAR d = MAX ( Dates[Date] )
        RETURN
            COALESCE (
                CALCULATE (
                    COUNTROWS ( SuiviValidationParagraphe ),
                    SuiviValidationParagraphe[Role] = "Valideur",
                    FILTER (
                        VALUES ( SuiviValidationParagraphe[Statut] ),
                        SuiviValidationParagraphe[Statut] = "Validé"
                            || CONTAINSSTRING ( SuiviValidationParagraphe[Statut], "Refus" )
                    ),
                    SuiviValidationParagraphe[DateContributionValidation] >= d,
                    SuiviValidationParagraphe[DateContributionValidation] < d + 1
                ),
                0
            )

    // ---------- 4.4 Couleurs ----------
    MEASURE '_Mesures'[Couleur file valideur] =
        SWITCH (
            TRUE (),
            [Nb attente > 5 j] > 0, "#C2410C",
            [Nb attente 3-5 j] > 0, "#F28C4B",
            "#1F5FD1"
        )

EVALUATE
    ROW (
        "Nb paragraphes", [Nb paragraphes],
        "Soumis", [Nb soumis],
        "Refusés", [Nb refusés à reprendre],
        "Non soumis", [Nb non soumis],
        "Validés N1", [Nb validés N1],
        "% Contribution", [% Contribution],
        "% Validation N1", [% Validation N1],
        "Taux de refus", [Taux de refus],
        "Délai décision (j)", [Délai de décision (j)],
        "Atterrissage", [Atterrissage prévu],
        "Compte à rebours", [Libellé compte à rebours]
    )
