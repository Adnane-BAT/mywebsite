var ok = 0;
foreach (var m in Model.Tables["_Mesures"].Measures)
{
    if (dossiers.ContainsKey(m.Name)) { m.DisplayFolder = dossiers[m.Name]; ok++; }
}
Info(ok + " mesures rangées sur " + dossiers.Count);
