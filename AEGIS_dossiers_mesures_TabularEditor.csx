    { "Couleur taux de refus", "1 Cockpit\\Couleurs" },
    { "Couleur atterrissage", "1 Cockpit\\Couleurs" },
    { "Couleur compte à rebours", "1 Cockpit\\Couleurs" },
    { "Couleur Porte N2", "1 Cockpit\\Couleurs" },
    { "Couleur barre contribution", "1 Cockpit\\Couleurs" },
    { "Aujourd'hui", "2 Trajectoire" },
    { "% Contribution cumulée", "2 Trajectoire" },
    { "% Validation cumulée", "2 Trajectoire" },
    { "Rythme idéal", "2 Trajectoire" },
    { "Projection contribution", "2 Trajectoire" },
    { "Point atterrissage", "2 Trajectoire" },
