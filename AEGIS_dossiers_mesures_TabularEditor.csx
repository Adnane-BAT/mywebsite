// AEGIS — rangement des mesures en dossiers d'affichage
// Tabular Editor 2 ou 3 : External Tools → Tabular Editor → onglet C# Script → coller → Run (F5) → Ctrl+S
var dossiers = new Dictionary<string, string> {
    { "Date fermeture", "1 Cockpit\\Calendrier" },
    { "Date lancement", "1 Cockpit\\Calendrier" },
    { "Jours avant fermeture", "1 Cockpit\\Calendrier" },
