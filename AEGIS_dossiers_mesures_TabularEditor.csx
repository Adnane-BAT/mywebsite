    { "Couleur cellule chapitre", "3 Contributeurs\\Carte des chapitres" },
    { "Nb en attente valideur", "4 Valideurs\\File d'attente" },
    { "Nb attente 0-2 j", "4 Valideurs\\File d'attente" },
    { "Nb attente 3-5 j", "4 Valideurs\\File d'attente" },
    { "Nb attente > 5 j", "4 Valideurs\\File d'attente" },
    { "% attente > 5 j", "4 Valideurs\\File d'attente" },
