    { "Porte N2", "1 Cockpit\\Par rapport" },
    { "Nb rapports sans N2", "1 Cockpit\\Alertes" },
    { "Nb chapitres partiellement soumis", "1 Cockpit\\Alertes" },
    { "Libellé alerte N2", "1 Cockpit\\Alertes" },
    { "Libellé alerte chapitres", "1 Cockpit\\Alertes" },
