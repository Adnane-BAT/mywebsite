			SEARCH(""sultat"", 'Plans d actions'[Nom du plan], 1, 0) >= 1
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Actions'[Nom de l'action])),
			" & ConditionsDAX & "
		)

