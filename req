
let
    // URL du site SharePoint
    SiteURL = "https://entreprise.sharepoint.com/sites/MonSite",

    // Toutes les listes et bibliothèques du site
    Source = SharePoint.Tables(
        SiteURL,
        [ApiVersion = 15]
    ),

    // Extraction des métadonnées des documents
    Extraction = Table.AddColumn(
        Source,
        "Documents",
        each
            let
                NomBibliotheque = [Title],
                Donnees = try [Items] otherwise null,

                Resultat =
                    if Donnees = null then
                        #table({}, {})
                    else
                        let
                            AvecBibliotheque = Table.AddColumn(
                                Donnees,
                                "Bibliothèque",
                                each NomBibliotheque,
                                type text
                            ),

                            Colonnes = Table.SelectColumns(
                                AvecBibliotheque,
                                {
                                    "Bibliothèque",
                                    "FileLeafRef",
                                    "FileRef",
                                    "FileDirRef",
                                    "FSObjType",
                                    "Modified",
                                    "Editor",
                                    "FieldValuesAsText"
                                },
                                MissingField.UseNull
                            )
                        in
                            Colonnes
            in
                Resultat
    ),

    // Consolidation
    Consolidation = Table.Combine(Extraction[Documents]),

    // Conserver uniquement les fichiers (pas les dossiers)
    Fichiers = Table.SelectRows(
        Consolidation,
        each
            let
                TypeObjet = try Number.From([FSObjType]) otherwise null
            in
                TypeObjet = 0
                and [FileLeafRef] <> null
                and [FileRef] <> null
    ),

    // Fonction d'extraction du nom du modificateur
    NomPersonne = (valeur as any, texte as any) as nullable text =>
        let
            Nom =
                if Value.Is(valeur, type record) then
                    Record.FieldOrDefault(
                        valeur,
                        "title",
                        Record.FieldOrDefault(valeur, "Title", null)
                    )
                else if Value.Is(valeur, type table) then
                    try valeur{0}[title] otherwise null
                else if Value.Is(valeur, type list) then
                    try valeur{0}[title] otherwise null
                else if Value.Is(valeur, type text) then
                    valeur
                else
                    null,

            NomTexte =
                if Value.Is(texte, type record) then
                    Record.FieldOrDefault(texte, "Editor", null)
                else
                    null,

            Resultat =
                if Nom <> null then Text.From(Nom)
                else if NomTexte <> null then Text.From(NomTexte)
                else null
        in
            Resultat,

    // Récupération du dernier modificateur
    AjoutModificateur = Table.AddColumn(
        Fichiers,
        "Modifié par",
        each NomPersonne([Editor], [FieldValuesAsText]),
        type text
    ),

    // Lien direct du document
    AjoutLien = Table.AddColumn(
        AjoutModificateur,
        "Lien document",
        each
            Uri.Parts(SiteURL)[Scheme]
            & "://"
            & Uri.Parts(SiteURL)[Host]
            & [FileRef],
        type text
    ),

    // Sélection des colonnes finales
    Selection = Table.SelectColumns(
        AjoutLien,
        {
            "Bibliothèque",
            "FileLeafRef",
            "Modified",
            "Modifié par",
            "FileDirRef",
            "Lien document"
        }
    ),

    // Renommage
    Renommage = Table.RenameColumns(
        Selection,
        {
            {"FileLeafRef", "Document"},
            {"Modified", "Dernière modification"},
            {"FileDirRef", "Répertoire"}
        }
    ),

    // Tri des modifications récentes
    Tri = Table.Sort(
        Renommage,
        {{"Dernière modification", Order.Descending}}
    )
in
    Tri



🗄️ Data (SharePoint ou Dataverse)
Campagne : trimestre, dates d’ouverture et de clôture, statut
Dossier (Population) : clé Trimestre|Onglet|TiersLocal, établissement, indicateurs agrégés, nb de lignes de détail, « présente aussi dans », statut, dates
Question : socle commun + question spécifique par onglet, ordre, obligatoire oui/non
Réponse : dossier, question, valeur, commentaire, auteur, date
Échange : fil des messages (dossier, émetteur, sens Direction ↔ Établissement, message, date)
Établissement (référentiel) : code, nom, groupe AD, mails des correspondants
Direction : liste nominative des utilisateurs (pas de groupe AD de ce côté)
Paramètres : délai de relance, URL du PBI, etc.
Bibliothèque PJ : un dossier par dossier de contrôle
Pour la volumétrie : index sur Établissement, Campagne et Statut
📊 Power BI
Requête DAX d’agrégation : passage du grain détail au grain dossier, utilisée par le flow de chargement
Page de détail avec filtre par URL sur le tiers local (le lien « voir le détail » ouvert depuis l’app)
Nouvelles sources : les listes Dossier et Réponse
Pages de suivi : taux de réponse, taux de conformité par établissement et par onglet, dossiers en retard, délai moyen de réponse
RLS par établissement, si le PBI est diffusé aux établissements
📱 Power Apps
Gestion du profil au démarrage : Direction (liste nominative) ou Établissement (groupe AD), et périmètre visible
Écrans :
Accueil avec compteurs (à traiter, en attente, clôturés)
Liste Direction : filtres, sélection multiple, interrogation en masse
« Mes dossiers » côté Établissement
Fiche dossier : en-tête agrégé, lien PBI, questionnaire dynamique, fil d’échanges, PJ
Admin : campagnes, questions, référentiel établissements
Composants réutilisables : en-tête, badge de statut, fil de messages, panneau de filtres
Règles de gestion :
transitions de statut
commentaire obligatoire si non conforme
verrouillage du dossier après clôture
un établissement ne voit que ses propres dossiers
⚡ Power Automate
Chargement de campagne (manuel ou trimestriel) : requête DAX, upsert des dossiers, création des dossiers PJ
Interrogation (une ou plusieurs questions, appelée depuis l’app) : mise à jour du statut et mail à l’établissement
Notification de réponse : mail à la Direction
Relance planifiée (quotidienne) : dossiers sans réponse au-delà de X jours
Clôture de campagne : figer les statuts, archiver, rafraîchir le dataset PBI
