            - btnValidationMasse:
                Control: Classic/Button@2.2.0
                Properties:
                  BorderColor: =RGBA(201, 184, 242, 1)
                  BorderThickness: =1
                  Color: =RGBA(76, 29, 149, 1)
                  Fill: =RGBA(255, 255, 255, 1)
                  Font: =Font.'Segoe UI'
                  Height: =44
                  HoverColor: =RGBA(76, 29, 149, 1)
                  HoverFill: =RGBA(243, 238, 253, 1)
                  OnSelect: |-
                    =With(
                        {aValider: Filter(colSelection As s, LookUp(colStatuts As st, st.Contrat = s.Contrat).Statut = "Soumis")},
                        If(
                            CountRows(aValider) = 0,
                            Notify("Aucun contrat au statut « Soumis » dans la sélection.", NotificationType.Warning),
                            ForAll(
                                aValider As s,
                                With(
                                    {c: LookUp(CP_SuiviContrats, Titre = s.Contrat)},
                                    Patch(
                                        CP_HistoriqueStatuts,
                                        Defaults(CP_HistoriqueStatuts),
                                        {
                                            Titre: s.Contrat,
                                            AncienStatut: "Soumis",
                                            NouveauStatut: "Validé",
                                            TypeAction: {Value: "Validation de masse"},
                                            PlanActionID: c.DernierPlanID,
                                            Commentaire: txtCommentaire.Text
                                        }
                                    );
                                    Patch(CP_SuiviContrats, c, {Statut: {Value: "Validé"}, ValideParEmail: User().Email, DateValidation: Now()})
                                )
                            );
                            Notify(
                                CountRows(aValider) & " contrat(s) validé(s)" &
                                If(CountRows(colSelection) > CountRows(aValider), " — " & (CountRows(colSelection) - CountRows(aValider)) & " ignoré(s) (pas au statut Soumis)", ""),
                                NotificationType.Success
                            );
                            ClearCollect(colStatuts, ForAll(CP_SuiviContrats As r, {Contrat: r.Titre, Statut: r.Statut.Value}));
                            Clear(colSelection);
                            Reset(chkTous);
                            //PowerBIIntegration.Refresh()
                        )
                    )
                  PressedFill: =RGBA(233, 223, 252, 1)
                  Size: =11
                  Text: ="✓  Validation de masse"
                  Width: =186
                  X: =170
                  Y: =724
