                                        ContratsConcernes: Concat(colSelection, Contrat, "; ")
                                    }
                                )
                            );
                            ForAll(
                                colSelection As s,
                                With(
                                    {c: LookUp(CP_SuiviContrats, Titre = s.Contrat)},
                                    Patch(
                                        CP_HistoriqueStatuts,
                                        Defaults(CP_HistoriqueStatuts),
                                        {
                                            Titre: s.Contrat,
                                            AncienStatut: Coalesce(c.Statut.Value, "À traiter"),
                                            NouveauStatut: "Soumis",
                                            TypeAction: {Value: "Soumission"},
                                            PlanActionID: varPlan.ID,
                                            Commentaire: txtCommentaire.Text
                                        }
                                    );
                                    If(
                                        IsBlank(c),
                                        Patch(CP_SuiviContrats, Defaults(CP_SuiviContrats), {Titre: s.Contrat, Volet: {Value: volet}, Statut: {Value: "Soumis"}, DernierPlanID: varPlan.ID}),
                                        Patch(CP_SuiviContrats, c, {Statut: {Value: "Soumis"}, DernierPlanID: varPlan.ID})
                                    )
                                )
                            );
                            ClearCollect(colStatuts, ForAll(CP_SuiviContrats As r, {Contrat: r.Titre, Statut: r.Statut.Value}));
                            Notify("Plan d'action soumis : " & CountRows(colSelection) & " contrat(s).", NotificationType.Success);
                            Clear(colSelection);
                            Set(varCommentaire, Blank()); Reset(txtLibelle); Reset(dpEcheance); Reset(txtAvancement); Reset(txtCommentaire); Reset(chkTous);
                        )
                    )
