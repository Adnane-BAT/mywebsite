    // ===== Paramètres : codes contrôle =====
    ListRef = List.Buffer(
        List.Distinct(List.RemoveNulls(List.Transform(pRefControle, Text.From)))
    ),
    ConditionsDAX = Text.Combine(
        List.Transform(
            List.Distinct(List.Transform(ListRef, each Text.Start(_, 15))),
            each "SEARCH(""" & _ & """, 'Actions'[Nom de l'action], 1, 0) >= 1"
        ),
        " || "
    ),
    PrefixesRef = List.Distinct(
        List.Transform(ListRef, each Text.BeforeDelimiter(_, ".") & ".")
